<?xml version="1.0"?>
<!--
  Interbotix WidowX 250 6DOF (wx250s) as a macro with our frame names (prefix "arm_").
  Kinematics, limits, masses and inertias are copied from
  Interbotix/interbotix_ros_manipulators (jazzy, 01c557d)
  interbotix_ros_xsarms/interbotix_xsarm_descriptions/urdf/wx250s.urdf.xacro,
  BSD-3-Clause, Copyright Trossen Robotics. Meshes are used from that package.
  Option gripper:=wide replaces the gripper bar and fingers with custom long jaws (same link
  and joint names); gripper:=stock is the Interbotix gripper.
  Changes: link/joint names, no ros2_control/gazebo includes, the servo horn
  ("gripper" continuous joint) is fixed, no mimic on the right finger (both fingers
  are commanded), no AR tag. Simulator-agnostic: no <gazebo> or <ros2_control> here.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="wx_mesh" value="file://$(find interbotix_xsarm_descriptions)/meshes/wx250s_meshes"/>
  <xacro:property name="wx_pi_offset" value="0.00001"/>

  <material name="arm_dark_grey">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <!-- one link with the same mesh as visual and collision -->
  <xacro:macro name="wx_link" params="name mesh vis_rpy:='0 0 0' vis_xyz:='0 0 0'
                                      com_rpy:='0 0 0' com_xyz m ixx iyy izz ixy ixz iyz">
    <link name="${name}">
      <visual>
        <origin rpy="${vis_rpy}" xyz="${vis_xyz}"/>
        <geometry><mesh filename="${wx_mesh}/${mesh}.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="arm_dark_grey"/>
      </visual>
      <collision>
        <origin rpy="${vis_rpy}" xyz="${vis_xyz}"/>
        <geometry><mesh filename="${wx_mesh}/${mesh}.stl" scale="0.001 0.001 0.001"/></geometry>
      </collision>
      <inertial>
        <origin rpy="${com_rpy}" xyz="${com_xyz}"/>
        <mass value="${m}"/>
        <inertia ixx="${ixx}" iyy="${iyy}" izz="${izz}" ixy="${ixy}" ixz="${ixz}" iyz="${iyz}"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="wx_revolute" params="name parent child axis xyz lower upper effort">
    <joint name="${name}" type="revolute">
      <axis xyz="${axis}"/>
      <limit effort="${effort}" lower="${lower}" upper="${upper}" velocity="${pi}"/>
      <origin rpy="0 0 0" xyz="${xyz}"/>
      <parent link="${parent}"/>
      <child link="${child}"/>
      <dynamics friction="0.1" damping="0.1"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="dummy_inertial">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <!-- The arm. Its root link is arm_base_link (frame fixed by notes/architecture.md). -->
  <xacro:macro name="wx250s_arm" params="parent gripper:=stock *origin">

    <joint name="arm_mount_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="arm_base_link"/>
    </joint>

    <xacro:wx_link name="arm_base_link" mesh="base" vis_rpy="0 0 ${pi/2}" com_rpy="0 0 ${pi/2}"
      com_xyz="-0.0380446000 0.0006138920 0.0193354000" m="0.538736"
      ixx="0.0021150000" iyy="0.0006921000" izz="0.0025240000"
      ixy="-0.0000163500" ixz="0.0000006998" iyz="0.0000464200"/>

    <xacro:wx_revolute name="arm_waist" parent="arm_base_link" child="arm_shoulder_link"
      axis="0 0 1" xyz="0 0 0.072" lower="${-pi + wx_pi_offset}" upper="${pi - wx_pi_offset}" effort="10"/>

    <xacro:wx_link name="arm_shoulder_link" mesh="shoulder" vis_rpy="0 0 ${pi/2}" vis_xyz="0 0 -0.003"
      com_rpy="0 0 ${pi/2}" com_xyz="0.0000223482 0.0000414609 0.0066287000" m="0.480879"
      ixx="0.0003790000" iyy="0.0005557000" izz="0.0005889000"
      ixy="0.0000000022" ixz="-0.0000003561" iyz="0.0000012245"/>

    <xacro:wx_revolute name="arm_shoulder" parent="arm_shoulder_link" child="arm_upper_arm_link"
      axis="0 1 0" xyz="0 0 0.03865" lower="${radians(-108)}" upper="${radians(114)}" effort="20"/>

    <xacro:wx_link name="arm_upper_arm_link" mesh="upper_arm" vis_rpy="0 0 ${pi/2}"
      com_rpy="0 0 ${pi/2}" com_xyz="0.0171605000 0.0000002725 0.1913230000" m="0.430811"
      ixx="0.0034630000" iyy="0.0035870000" izz="0.0004566000"
      ixy="-0.0000000001" ixz="-0.0000000002" iyz="0.0004272000"/>

    <xacro:wx_revolute name="arm_elbow" parent="arm_upper_arm_link" child="arm_upper_forearm_link"
      axis="0 1 0" xyz="0.04975 0 0.25" lower="${radians(-123)}" upper="${radians(92)}" effort="15"/>

    <xacro:wx_link name="arm_upper_forearm_link" mesh="upper_forearm"
      com_xyz="0.1079630000 0.0001158760 0" m="0.234589"
      ixx="0.0000397100" iyy="0.0008878000" izz="0.0008880000"
      ixy="0.0000023528" ixz="0" iyz="0"/>

    <xacro:wx_revolute name="arm_forearm_roll" parent="arm_upper_forearm_link" child="arm_lower_forearm_link"
      axis="1 0 0" xyz="0.175 0 0" lower="${-pi + wx_pi_offset}" upper="${pi - wx_pi_offset}" effort="2"/>

    <xacro:wx_link name="arm_lower_forearm_link" mesh="lower_forearm" vis_rpy="${pi} 0 0"
      com_rpy="${pi} 0 0" com_xyz="0.0374395000 0.0052225200 0" m="0.220991"
      ixx="0.0000636900" iyy="0.0001677000" izz="0.0001834000"
      ixy="-0.0000229200" ixz="0" iyz="0"/>

    <xacro:wx_revolute name="arm_wrist_angle" parent="arm_lower_forearm_link" child="arm_wrist_link"
      axis="0 1 0" xyz="0.075 0 0" lower="${radians(-100)}" upper="${radians(123)}" effort="5"/>

    <xacro:wx_link name="arm_wrist_link" mesh="wrist" vis_rpy="0 0 ${pi/2}"
      com_rpy="0 0 ${pi/2}" com_xyz="0.0423600000 -0.0000106630 0.0105770000" m="0.084957"
      ixx="0.0000308200" iyy="0.0000282200" izz="0.0000315200"
      ixy="0.0000000191" ixz="0.0000000023" iyz="0.0000025481"/>

    <xacro:wx_revolute name="arm_wrist_rotate" parent="arm_wrist_link" child="arm_gripper_link"
      axis="1 0 0" xyz="0.065 0 0" lower="${-pi + wx_pi_offset}" upper="${pi - wx_pi_offset}" effort="1"/>

    <xacro:wx_link name="arm_gripper_link" mesh="gripper" vis_rpy="0 0 ${pi/2}" vis_xyz="-0.02 0 0"
      com_rpy="0 0 ${pi/2}" com_xyz="0.0216310000 0.0000002516 0.0114100000" m="0.072885"
      ixx="0.0000253700" iyy="0.0000183600" izz="0.0000167400"
      ixy="0" ixz="0" iyz="0.0000004340"/>

    <joint name="arm_ee_arm" type="fixed">
      <origin rpy="0 0 0" xyz="0.043 0 0"/>
      <parent link="arm_gripper_link"/>
      <child link="arm_ee_arm_link"/>
    </joint>
    <link name="arm_ee_arm_link"><xacro:dummy_inertial/></link>

    <!-- servo horn: continuous in the original, fixed here (purely visual) -->
    <joint name="arm_gripper_prop" type="fixed">
      <origin rpy="0 0 0" xyz="0.0055 0 0"/>
      <parent link="arm_ee_arm_link"/>
      <child link="arm_gripper_prop_link"/>
    </joint>
    <xacro:wx_link name="arm_gripper_prop_link" mesh="gripper_prop" vis_rpy="0 0 ${pi/2}" vis_xyz="-0.0685 0 0"
      com_rpy="0 0 ${pi/2}" com_xyz="0.0008460000 -0.0000016817 0.0000420000" m="0.00434"
      ixx="0.0000005923" iyy="0.0000011156" izz="0.0000005743"
      ixy="0" ixz="0.0000003195" iyz="-0.0000000004"/>

    <xacro:if value="${gripper == 'stock'}">
    <joint name="arm_gripper_bar" type="fixed">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <parent link="arm_ee_arm_link"/>
      <child link="arm_gripper_bar_link"/>
    </joint>
    <xacro:wx_link name="arm_gripper_bar_link" mesh="gripper_bar" vis_rpy="0 0 ${pi/2}" vis_xyz="-0.063 0 0"
      com_rpy="0 0 ${pi/2}" com_xyz="0.0096870000 0.0000008177 0.0049620000" m="0.034199"
      ixx="0.0000074125" iyy="0.0000284300" izz="0.0000286000"
      ixy="-0.0000000008" ixz="-0.0000000006" iyz="-0.0000013889"/>

    <joint name="arm_ee_bar" type="fixed">
      <origin rpy="0 0 0" xyz="0.023 0 0"/>
      <parent link="arm_gripper_bar_link"/>
      <child link="arm_fingers_link"/>
    </joint>
    <link name="arm_fingers_link"><xacro:dummy_inertial/></link>

    <!-- fingers: 0.015 m (closed) .. 0.037 m (open) from the centre each -->
    <joint name="arm_left_finger" type="prismatic">
      <axis xyz="0 1 0"/>
      <limit effort="5" lower="0.015" upper="0.037" velocity="1"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <parent link="arm_fingers_link"/>
      <child link="arm_left_finger_link"/>
      <dynamics friction="0.1" damping="0.1"/>
    </joint>
    <xacro:wx_link name="arm_left_finger_link" mesh="gripper_finger" vis_rpy="${pi} ${pi} 0" vis_xyz="0 0.005 0"
      com_rpy="${pi} ${pi} ${pi/2}" com_xyz="0.0138160000 0 0" m="0.016246"
      ixx="0.0000047310" iyy="0.0000015506" izz="0.0000037467"
      ixy="-0.0000004560" ixz="0" iyz="0"/>

    <joint name="arm_right_finger" type="prismatic">
      <axis xyz="0 1 0"/>
      <limit effort="5" lower="-0.037" upper="-0.015" velocity="1"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <parent link="arm_fingers_link"/>
      <child link="arm_right_finger_link"/>
      <dynamics friction="0.1" damping="0.1"/>
    </joint>
    <xacro:wx_link name="arm_right_finger_link" mesh="gripper_finger" vis_rpy="0 ${pi} 0" vis_xyz="0 -0.005 0"
      com_rpy="0 ${pi} ${pi/2}" com_xyz="0.0138160000 0 0" m="0.016246"
      ixx="0.0000047310" iyy="0.0000015506" izz="0.0000037467"
      ixy="0.0000004560" ixz="0" iyz="0"/>

    <!-- tool centre point between the fingertips -->
    <joint name="arm_ee_gripper" type="fixed">
      <origin rpy="0 0 0" xyz="0.027575 0 0"/>
      <parent link="arm_fingers_link"/>
      <child link="arm_ee_gripper_link"/>
    </joint>
    <link name="arm_ee_gripper_link"><xacro:dummy_inertial/></link>

    <!-- jaw tips (finger mesh ends 0.043 m from arm_fingers_link): 15.4 mm beyond the TCP.
         Grasp height for low items: put THIS frame just above the ground, not the TCP. -->
    <joint name="arm_jaw_tips" type="fixed">
      <origin rpy="0 0 0" xyz="0.043 0 0"/>
      <parent link="arm_fingers_link"/>
      <child link="arm_jaw_tips_link"/>
    </joint>
    <link name="arm_jaw_tips_link"><xacro:dummy_inertial/></link>

    </xacro:if>

    <xacro:if value="${gripper == 'wide'}">
    <!-- WIDE gripper (variant "custom", notes/decisions.md 2026-10-12): custom long jaws on a
         wider slide, driven by the stock gripper servo (arm_gripper_link). Not a catalogue part.
         Gap between the jaw faces = 2 * finger joint value: 0.010 -> 2 cm, 0.075 -> 15 cm.
         Masses: slide 0.12 kg, each jaw 0.07 kg; whole gripper ~0.34 kg (stock ~0.14 kg).
         Finger force limit 5 N, as stock. -->
    <joint name="arm_gripper_bar" type="fixed">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <parent link="arm_ee_arm_link"/>
      <child link="arm_gripper_bar_link"/>
    </joint>
    <link name="arm_gripper_bar_link">
      <visual><origin xyz="0.0125 0 0"/><geometry><box size="0.025 0.18 0.035"/></geometry>
        <material name="arm_dark_grey"/></visual>
      <collision><origin xyz="0.0125 0 0"/><geometry><box size="0.025 0.18 0.035"/></geometry></collision>
      <inertial>
        <origin xyz="0.0125 0 0"/>
        <mass value="0.12"/>
        <inertia ixx="${0.12*(0.18**2 + 0.035**2)/12}" iyy="${0.12*(0.025**2 + 0.035**2)/12}"
                 izz="${0.12*(0.025**2 + 0.18**2)/12}" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <joint name="arm_ee_bar" type="fixed">
      <origin rpy="0 0 0" xyz="0.025 0 0"/>
      <parent link="arm_gripper_bar_link"/>
      <child link="arm_fingers_link"/>
    </joint>
    <link name="arm_fingers_link"><xacro:dummy_inertial/></link>

    <!-- jaw: 85 mm long, 6 mm thick, 30 mm high; inner face at the joint position -->
    <xacro:macro name="wide_jaw" params="side sign">
      <link name="arm_${side}_finger_link">
        <visual><origin xyz="0.0425 ${sign*0.003} 0"/><geometry><box size="0.085 0.006 0.03"/></geometry>
          <material name="arm_dark_grey"/></visual>
        <collision><origin xyz="0.0425 ${sign*0.003} 0"/><geometry><box size="0.085 0.006 0.03"/></geometry></collision>
        <inertial>
          <origin xyz="0.0425 ${sign*0.003} 0"/>
          <mass value="0.07"/>
          <inertia ixx="${0.07*(0.006**2 + 0.03**2)/12}" iyy="${0.07*(0.085**2 + 0.03**2)/12}"
                   izz="${0.07*(0.085**2 + 0.006**2)/12}" ixy="0" ixz="0" iyz="0"/>
        </inertial>
      </link>
    </xacro:macro>
    <xacro:wide_jaw side="left" sign="1"/>
    <xacro:wide_jaw side="right" sign="-1"/>

    <joint name="arm_left_finger" type="prismatic">
      <axis xyz="0 1 0"/>
      <!-- 5 N like the stock gripper: same servo, longer stroke -> no more force (rather less) -->
      <limit effort="5" lower="0.010" upper="0.075" velocity="1"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <parent link="arm_fingers_link"/>
      <child link="arm_left_finger_link"/>
      <dynamics friction="0.1" damping="0.1"/>
    </joint>
    <joint name="arm_right_finger" type="prismatic">
      <axis xyz="0 1 0"/>
      <limit effort="5" lower="-0.075" upper="-0.010" velocity="1"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <parent link="arm_fingers_link"/>
      <child link="arm_right_finger_link"/>
      <dynamics friction="0.1" damping="0.1"/>
    </joint>

    <!-- tool centre point between the jaws, 30 mm back from the tips -->
    <joint name="arm_ee_gripper" type="fixed">
      <origin rpy="0 0 0" xyz="0.055 0 0"/>
      <parent link="arm_fingers_link"/>
      <child link="arm_ee_gripper_link"/>
    </joint>
    <link name="arm_ee_gripper_link"><xacro:dummy_inertial/></link>

    <!-- jaw tips, 30 mm beyond the TCP. Grasp height for low items: put THIS frame just above
         the ground, not the TCP (TCP at the centre of a 2.2 cm cigarette pack = tips 2 cm deep). -->
    <joint name="arm_jaw_tips" type="fixed">
      <origin rpy="0 0 0" xyz="0.085 0 0"/>
      <parent link="arm_fingers_link"/>
      <child link="arm_jaw_tips_link"/>
    </joint>
    <link name="arm_jaw_tips_link"><xacro:dummy_inertial/></link>
    </xacro:if>

  </xacro:macro>
</robot>
