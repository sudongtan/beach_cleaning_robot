<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sim_bridge_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo Harmonic bridge: Gazebo robot variant (ros2_control + sensors), controller config, launch, topic bridge, ground truth, attach/detach.</description>
  <maintainer email="frances.tanx@gmail.com">Frances Tan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rosgraph_msgs</depend>

  <exec_depend>beach_description</exec_depend>
  <exec_depend>go2_description</exec_depend>
  <exec_depend>gz_quadruped_hardware</exec_depend>
  <exec_depend>basic_quadruped_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>imu_sensor_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>beach_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>gz_transport_vendor</exec_depend>
  <exec_depend>gz_msgs_vendor</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
