<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bringup</name>
  <version>0.1.0</version>
  <description>Top-level launch (sim:=gazebo|isaac) and test commands.</description>
  <maintainer email="frances.tanx@gmail.com">Frances Tan</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>beach_description</exec_depend>
  <exec_depend>locomotion</exec_depend>
  <exec_depend>sim_bridge_gazebo</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <exec_depend>localization</exec_depend>
  <exec_depend>mapping</exec_depend>
  <exec_depend>perception</exec_depend>
  <exec_depend>world_model</exec_depend>
  <exec_depend>safety</exec_depend>
  <exec_depend>navigation</exec_depend>
  <exec_depend>grasping</exec_depend>
  <exec_depend>task</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
