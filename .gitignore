__pycache__/
*.pyc
.venv/
# colcon output if built from here by mistake
build/
install/
log/
# large training artifacts
training/runs/
*.pt
*.onnx
results/plots/*.tmp

notes/
CLAUDE.md


# generated worlds and terrain exports (rebuilt by make world / make terrain)
sim/gazebo/worlds/generated/
sim/common/generated/

# raw task event logs (A2 task node); per-run summaries for metrics are kept
results/runs/*.jsonl

# benchmark run logs (launch output, recorder snapshots); the run JSONs results/runs/*.json are kept
results/bench/
results/bench_*.log
results/runs/*.tmp

# videos (hundreds of MB; record_video.py)
results/videos/
# record_video.py temp file in the Gazebo server working directory while recording
/[0-9]*.mp4

# B5 visual check frames and world (sim/gazebo/tools/visual_check.py); the contact sheet is kept
results/b5/frames/
results/b5/visual_check.sdf
results/b5/gz.log

# D0 prep: generated USD scenes (sim/isaac/load_scene.py)
sim/isaac/scenes/generated/
# Blender preview frames (sim/isaac/tools/blender_preview.py); the contact sheet is kept
results/d0_prep/blender/
# Gazebo reference frames (load_scene.py --debug-camera, laptop); the contact sheet is kept
results/d0_prep/gazebo/
# D0 prep GPU session outputs: full images, Kit logs, NVIDIA example, tarballs (kept on the Mac);
# checks.json / timing.json / host facts and the contact sheets are committed
results/d0_prep/*.tar.gz
results/d0_prep/d0_s*/kit_logs/
results/d0_prep/d0_s*/nvidia_example/
results/d0_prep/d0_s*/scene_*/rgb/
results/d0_prep/d0_s*/session.log
results/d0_prep/d0_s*/compat.txt
results/d0_prep/d0_s*/.done/

# D0b: imported robot USDs and composed test stages (sim/isaac/import_robot.py, compose.py)
sim/isaac/robots/generated/
sim/isaac/stages/generated/
# D0b/D0c GPU session outputs: the imported robot (third-party meshes), frames, Kit logs, tarballs
results/d0/*/robot/
results/d0/*/import/robot_usd.tgz
results/d0/*/kit_logs/
results/d0/*/*/frames/
results/d0/*.tgz
results/d0/*/.done/
